<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>Sign up · Blogify</title>
</head>
<body class = "auth-page">

  <main id="main" class="auth-sheet">
    <h1>Join Wordora.</h1>
    <p class="lede">Create an account and start writing.</p>

    <form action="/signup" method="POST">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="field-control">
          <input type="password" id="password" name="password" autocomplete="new-password" required>
          <button type="button" class="reveal" data-reveal="password" aria-pressed="false">Show</button>
        </div>
      </div>
      <button type="submit" class="green-btn block">Sign up</button>
    </form>

    <p class="switch">Already have an account? <a href="/login">Sign in</a></p>
  </main>

  <%- include("./partials/script") %>
</body>
</html>
