<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <div class="topbar-inner">
    <a class="wordmark" href="/">Wordora</a>
    <form class="nav-search" action="/search" method="get" role="search">
      <label class="visually-hidden" for="nav-search-input">Search Blogify</label>
      <svg class="nav-search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input id="nav-search-input" type="search" name="q" placeholder="Search" autocomplete="off"
             value="<%= locals.query || '' %>">
    </form>
    <nav class="top-actions" aria-label="Account">
      <% if (locals.user) { %>
        <a class="write-link" href="/blog/add-new">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M12 20h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>Write</span>
        </a>
      
        <div class="account" data-account>
          <button type="button" class="avatar avatar-btn" data-account-toggle
        aria-haspopup="true" aria-expanded="false" aria-controls="account-menu"
        aria-label="Account menu">

    <% if (locals.user.profileImageUrl && locals.user.profileImageUrl != "/images/default.png") { %>
        <img src="<%= locals.user.profileImageUrl %>" 
             alt="Profile"
             class="dp-photo">
    <% } else { %>
        <%= (locals.user.username || "?").charAt(0).toUpperCase() %>
    <% } %>

</button>
      
          <div class="account-menu" id="account-menu" data-account-menu hidden>
            <div class="account-head">
              <span class="avatar" aria-hidden="true">
                <% if (locals.user.profileImageUrl && locals.user.profileImageUrl != "/images/default.png") { %>
                  <img src="<%= locals.user.profileImageUrl %>" 
                       alt="Profile"
                       class="dp-photo">
                <% } else { %>
                  <%= (locals.user.username || "?").charAt(0).toUpperCase() %>
                <% } %>
              </span>
              <div class="account-id">
                <p class="account-name">
                  <%= locals.user.username %>
                  <% if (locals.user.role === "ADMIN") { %><span class="role-label">· Admin</span><% } %>
                </p>
                <p class="account-email"><%= locals.user.email || "" %></p>
              </div>
            </div>
            <a class="account-item" href="/myprofile">Profile</a>
            <a class="account-item" href="/logout">Sign out</a>
          </div>
        </div>
      <% } else { %>
        <a class="text-btn" href="/login">Sign in</a>
        <a class="green-btn" href="/signup">Sign up</a>
      <% } %>
      <button type="button" class="icon-btn" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
          </g>
        </svg>
      </button>
    </nav>
  </div>
</header>
<%- include("./sidebar") %>
<% if (locals.error) { %>
<p class="banner" role="alert"><%= locals.error %></p>
<% } %>
