<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>Sign in · Blogify</title>
</head>
<body>
  <%- include("./partials/navbar") %>

  <main id="main" class="auth-sheet">
    <h1>Welcome back.</h1>
    <p class="lede">Sign in to keep writing.</p>

    <form action="/login" method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="field-control">
          <input type="password" id="password" name="password" autocomplete="current-password" required>
          <button type="button" class="reveal" data-reveal="password" aria-pressed="false">Show</button>
        </div>
      </div>
      <button type="submit" class="green-btn block">Sign in</button>
    </form>

    <p class="switch">New here? <a href="/signup">Sign up</a></p>
  </main>

  <%- include("./partials/script") %>
</body>
</html>
